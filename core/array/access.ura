fn at(index i32) T:
    value T
    if index >= 0 and index < self.count:
        value = self.data[index]
    return value

fn first() &T:
    return &self.data[0]

fn last() &T:
    return &self.data[self.count - 1]

fn len() i32:
    return self.count

fn size() i32:
    return self.count

fn capacity() i32:
    return self.cap

fn is_empty() bool:
    return self.count == 0

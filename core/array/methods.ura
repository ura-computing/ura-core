// memory
fn reserve(cap i32):
    if cap < self.count:
        cap = self.count
    if cap <= self.cap:
        return
    bigger T[] = new<T>(cap)
    copy<T>(bigger, self.data, self.count)
    if self.cap > 0:
        free<T>(self.data)
    self.data = bigger
    self.cap = cap

fn own():
    if self.cap == 0 and self.count > 0:
        self.reserve(self.count)

fn resize(size i32):
    self.reserve(size)
    while self.count > size:
        self.count -= 1
        drop(self.data[self.count])
    self.count = size

fn clear():
    if self.cap == 0:
        self.count = 0
    while self.count > 0:
        self.count -= 1
        drop(self.data[self.count])

fn release():
    self.clear()
    if self.cap > 0:
        free<T>(self.data)
    drop(self.data)
    self.cap = 0

// modify
fn append(value T):
    if self.count >= self.cap:
        self.reserve(self.count * 2 + 4)
    self.data[self.count] = value
    self.count += 1

fn insert(index i32, value T):
    if self.count >= self.cap:
        self.reserve(self.count * 2 + 4)
    i i32 = self.count
    while i > index:
        self.data[i] = self.data[i - 1]
        i -= 1
    self.data[index] = value
    self.count += 1

fn remove(index i32):
    if index < 0 or index >= self.count:
        return
    self.own()

    i i32 = index
    while i < self.count - 1:
        self.data[i] = self.data[i + 1]
        i += 1

    self.count -= 1
    drop(self.data[self.count])

fn pop(index i32) T:
    value T
    if index < 0 or index >= self.count:
        return value
    self.own()
    value = self.data[index]
    i i32 = index
    while i < self.count - 1:
        self.data[i] = self.data[i + 1]
        i += 1
    self.count -= 1
    drop(self.data[self.count])
    return value

fn pop() T:
    return self.pop(self.count - 1)

fn reverse():
    self.own()
    i i32 = 0
    j i32 = self.count - 1
    while i < j:
        tmp T = self.data[i]
        self.data[i] = self.data[j]
        self.data[j] = tmp
        i += 1
        j -= 1

// access
fn at(index i32) T:
    value T
    if index >= 0 and index < self.count:
        value = self.data[index]
    return value

fn first() &T:
    return &self.data[0]

fn last() &T:
    return &self.data[self.count - 1]

fn len() i32:
    return self.count

fn size() i32:
    return self.count

fn capacity() i32:
    return self.cap

fn is_empty() bool:
    return self.count == 0

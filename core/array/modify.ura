fn append(value T):
    if self.count >= self.cap:
        self.reserve(self.count * 2 + 4)
    self.data[self.count] = value
    self.count += 1

fn insert(index i32, value T):
    if self.count >= self.cap:
        self.reserve(self.count * 2 + 4)
    i i32 = self.count
    while i > index:
        self.data[i] = self.data[i - 1]
        i -= 1
    self.data[index] = value
    self.count += 1

fn pop(index i32) T:
    value T
    if index < 0 or index >= self.count:
        return value
    self.own()
    value = self.data[index]
    i i32 = index
    while i < self.count - 1:
        self.data[i] = self.data[i + 1]
        i += 1
    self.count -= 1
    drop(self.data[self.count])
    return value

fn pop() T:
    return self.pop(self.count - 1)

fn reverse():
    self.own()
    i i32 = 0
    j i32 = self.count - 1
    while i < j:
        tmp T = self.data[i]
        self.data[i] = self.data[j]
        self.data[j] = tmp
        i += 1
        j -= 1

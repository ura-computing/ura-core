fn reserve(cap i32):
    if cap < self.count:
        cap = self.count
    if cap <= self.cap:
        return
    bigger T[] = new<T>(cap)
    copy<T>(bigger, self.data, self.count)
    if self.cap > 0:
        free<T>(self.data)
    self.data = bigger
    self.cap = cap

fn own():
    if self.cap == 0 and self.count > 0:
        self.reserve(self.count)

fn resize(size i32):
    self.reserve(size)
    while self.count > size:
        self.count -= 1
        drop(self.data[self.count])
    self.count = size

fn clear():
    if self.cap == 0:
        self.count = 0
    while self.count > 0:
        self.count -= 1
        drop(self.data[self.count])

fn release():
    self.clear()
    if self.cap > 0:
        free<T>(self.data)
    drop(self.data)
    self.cap = 0

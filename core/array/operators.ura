operator [](left &Array, index i32) &T:
    left.own()
    return &left.data[index]

operator =(left &Array, right &Array):
    left.clear()
    left.reserve(right.count)
    i i32 = 0
    while i < right.count:
        left.data[i] = right.data[i]
        i += 1
    left.count = right.count

operator in(left &Array, i &i32, x &T) bool:
    if i >= left.count:
        return False
    x = left.data[i]
    i += 1
    return True

operator drop(value &Array):
    value.clear()
    if value.cap > 0:
        free<T>(value.data)

operator ==(left &String, right &String) bool:
    return left.compare(right) == 0

operator !=(left &String, right &String) bool:
    return left.compare(right) != 0

operator <(left &String, right &String) bool:
    return left.compare(right) < 0

operator >(left &String, right &String) bool:
    return left.compare(right) > 0

operator ==(left &String, right i8[]) bool:
    return left.count == String::length_of(right) and left.matches_at(0, right)

operator !=(left &String, right i8[]) bool:
    return not (left == right)

operator =(left &String, right i8[]):
    left.assign(right)

operator =(left &i8[], right &String):
    left = right.chars()

operator +=(left &String, right i8[]):
    left.join(right)

operator +=(left &String, right &String):
    i i32 = 0
    while i < right.count:
        left.append(right.data[i])
        i += 1

operator +(left &String, right i8[]) String:
    res String = left
    res.join(right)
    return res

operator +(left &String, right &String) String:
    res String = left
    res += right
    return res

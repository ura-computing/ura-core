pub fn create(text i8[]) String:
    res String
    res.join(text)
    return res

pub fn create(number i32) String:
    res String
    n i32 = number
    if n < 0:
        n = 0 - n
    while True:
        res.append(((n % 10) + 48) as char)
        n /= 10
        if n == 0:
            break
    if number < 0:
        res.append('-')
    return res.reverse()

pub fn length_of(text i8[]) i32:
    n i32 = 0
    while text[n] != 0:
        n += 1
    return n

fn join(text i8[]):
    i i32 = 0
    while text[i] != 0:
        self.append(text[i])
        i += 1

fn assign(text i8[]):
    self.clear()
    self.join(text)

fn chars() i8[]:
    self.reserve(self.count + 1)
    self.data[self.count] = 0
    return self.data

fn to_int() i32:
    i i32 = 0
    sign i32 = 1
    if self.count > 0 and self.data[0] == '-':
        sign = -1
        i = 1
    n i32 = 0
    while i < self.count:
        c char = self.data[i]
        if c < '0' or c > '9':
            break
        n = n * 10 + (c as i32 - 48)
        i += 1
    return n * sign

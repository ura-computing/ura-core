fn compare(other &String) i32:
    i i32 = 0
    while i < self.count and i < other.count:
        if self.data[i] != other.data[i]:
            return (self.data[i] as i32) - (other.data[i] as i32)
        i += 1
    return self.count - other.count

fn matches_at(index i32, text i8[]) bool:
    j i32 = 0
    while text[j] != 0:
        if index + j >= self.count:
            return False
        if self.data[index + j] != text[j]:
            return False
        j += 1
    return True

fn find(text i8[]) i32:
    i i32 = 0
    while i < self.count:
        if self.matches_at(i, text):
            return i
        i += 1
    return -1

fn contains(text i8[]) bool:
    return self.find(text) != -1

fn starts_with(text i8[]) bool:
    return self.matches_at(0, text)

fn ends_with(text i8[]) bool:
    n i32 = String::length_of(text)
    if n > self.count:
        return False
    return self.matches_at(self.count - n, text)

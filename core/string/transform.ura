fn substr(start i32, length i32) String:
    res String
    if start < 0:
        return res
    stop i32 = start + length
    if stop > self.count:
        stop = self.count
    i i32 = start
    while i < stop:
        res.append(self.data[i])
        i += 1
    return res

fn upper() String:
    res String
    i i32 = 0
    while i < self.count:
        c char = self.data[i]
        if c >= 'a' and c <= 'z':
            c = (c as i32 - 32) as char
        res.append(c)
        i += 1
    return res

fn lower() String:
    res String
    i i32 = 0
    while i < self.count:
        c char = self.data[i]
        if c >= 'A' and c <= 'Z':
            c = (c as i32 + 32) as char
        res.append(c)
        i += 1
    return res

fn is_space(c char) bool:
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'

fn trim() String:
    start i32 = 0
    while start < self.count:
        if not self.is_space(self.data[start]):
            break
        start += 1
    stop i32 = self.count
    while stop > start:
        if not self.is_space(self.data[stop - 1]):
            break
        stop -= 1
    return self.substr(start, stop - start)

fn replace(old i8[], fresh i8[]) String:
    res String
    n i32 = String::length_of(old)
    i i32 = 0
    while i < self.count:
        if n > 0 and self.matches_at(i, old):
            res.join(fresh)
            i += n
        else:
            res.append(self.data[i])
            i += 1
    return res

fn repeat(times i32) String:
    res String
    k i32 = 0
    while k < times:
        i i32 = 0
        while i < self.count:
            res.append(self.data[i])
            i += 1
        k += 1
    return res

fn reverse() String:
    res String
    i i32 = self.count - 1
    while i >= 0:
        res.append(self.data[i])
        i -= 1
    return res

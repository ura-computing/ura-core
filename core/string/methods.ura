// create
pub fn create(text i8[]) String:
    res String
    res.join(text)
    return res

pub fn create(number i32) String:
    res String
    n i32 = number
    if n < 0:
        n = 0 - n
    while True:
        res.append(((n % 10) + 48) as char)
        n /= 10
        if n == 0:
            break
    if number < 0:
        res.append('-')
    return res.reverse()

pub fn length_of(text i8[]) i32:
    n i32 = 0
    while text[n] != 0:
        n += 1
    return n

fn join(text i8[]):
    i i32 = 0
    while text[i] != 0:
        self.append(text[i])
        i += 1

fn assign(text i8[]):
    self.clear()
    self.join(text)

fn chars() i8[]:
    self.reserve(self.count + 1)
    self.data[self.count] = 0
    return self.data

fn to_int() i32:
    i i32 = 0
    sign i32 = 1
    if self.count > 0 and self.data[0] == '-':
        sign = -1
        i = 1
    n i32 = 0
    while i < self.count:
        c char = self.data[i]
        if c < '0' or c > '9':
            break
        n = n * 10 + (c as i32 - 48)
        i += 1
    return n * sign

// search
fn compare(other &String) i32:
    i i32 = 0
    while i < self.count and i < other.count:
        if self.data[i] != other.data[i]:
            return (self.data[i] as i32) - (other.data[i] as i32)
        i += 1
    return self.count - other.count

fn matches_at(index i32, text i8[]) bool:
    j i32 = 0
    while text[j] != 0:
        if index + j >= self.count:
            return False
        if self.data[index + j] != text[j]:
            return False
        j += 1
    return True

fn find(text i8[]) i32:
    i i32 = 0
    while i < self.count:
        if self.matches_at(i, text):
            return i
        i += 1
    return -1

fn contains(text i8[]) bool:
    return self.find(text) != -1

fn starts_with(text i8[]) bool:
    return self.matches_at(0, text)

fn ends_with(text i8[]) bool:
    n i32 = String::length_of(text)
    if n > self.count:
        return False
    return self.matches_at(self.count - n, text)

// transform
fn substr(start i32, length i32) String:
    res String
    if start < 0:
        return res
    stop i32 = start + length
    if stop > self.count:
        stop = self.count
    i i32 = start
    while i < stop:
        res.append(self.data[i])
        i += 1
    return res

fn upper() String:
    res String
    i i32 = 0
    while i < self.count:
        c char = self.data[i]
        if c >= 'a' and c <= 'z':
            c = (c as i32 - 32) as char
        res.append(c)
        i += 1
    return res

fn lower() String:
    res String
    i i32 = 0
    while i < self.count:
        c char = self.data[i]
        if c >= 'A' and c <= 'Z':
            c = (c as i32 + 32) as char
        res.append(c)
        i += 1
    return res

fn is_space(c char) bool:
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'

fn trim() String:
    start i32 = 0
    while start < self.count:
        if not self.is_space(self.data[start]):
            break
        start += 1
    stop i32 = self.count
    while stop > start:
        if not self.is_space(self.data[stop - 1]):
            break
        stop -= 1
    return self.substr(start, stop - start)

fn replace(old i8[], fresh i8[]) String:
    res String
    n i32 = String::length_of(old)
    i i32 = 0
    while i < self.count:
        if n > 0 and self.matches_at(i, old):
            res.join(fresh)
            i += n
        else:
            res.append(self.data[i])
            i += 1
    return res

fn repeat(times i32) String:
    res String
    k i32 = 0
    while k < times:
        i i32 = 0
        while i < self.count:
            res.append(self.data[i])
            i += 1
        k += 1
    return res

fn reverse() String:
    res String
    i i32 = self.count - 1
    while i >= 0:
        res.append(self.data[i])
        i -= 1
    return res
